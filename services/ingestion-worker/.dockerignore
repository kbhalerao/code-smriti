# The Dockerfile runs `COPY . .`; keep secrets, logs and local state out of the image.
# An image built before this file existed carried a GitHub token in a log file.
.env
.env.*
!.env.example
*.log
logs/
.venv/
__pycache__/
**/*.pyc
.pytest_cache/
.archive/
.claude/
*.ipynb
*_results.json
scripts/*_results/
