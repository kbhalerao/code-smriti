{
  "mcpServers": {
    "code-smriti": {
      "command": "uv",
      "args": [
        "--directory", "/path/to/code-smriti",
        "run",
        "python", "-m", "services.mcp-server.rag_mcp_server"
      ],
      "env": {
        "CODESMRITI_API_URL": "https://smriti.example.com",
        "CODESMRITI_TOKEN": "cos_pat_your-personal-access-token"
      }
    },
    "chief-of-staff": {
      "command": "uv",
      "args": [
        "--directory", "/path/to/chief-of-staff",
        "run",
        "python", "-m", "mcp_server.cos_mcp_server"
      ],
      "env": {
        "COS_API_URL": "http://localhost:8001",
        "COS_TOKEN": "cos_pat_your-personal-access-token"
      }
    }
  }
}
